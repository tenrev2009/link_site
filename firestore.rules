rules_version = '2';

// À copier dans la console Firebase : Firestore Database → Règles.
// Remplacer ADMIN_EMAIL par l'adresse utilisée pour se connecter à /admin.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'ADMIN_EMAIL';
    }

    // Visiteurs : uniquement les liens publics (la requête doit filtrer sur status == 'public').
    // Admin : tout, y compris les liens privés et à valider.
    match /links/{linkId} {
      allow read: if resource.data.status == 'public' || isAdmin();
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
